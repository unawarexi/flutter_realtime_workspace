# ── Dependencies (reinstalled inside container) ────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# ── Runtime data ───────────────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock
logs/
*.log
pids/

# ── Testing ────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
test/
tests/

# ── Build artifacts ────────────────────────────────────────────────────────
dist/
build/

# ── Version control ────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Local config (injected at runtime via env_file / Kubernetes secrets) ───
.env
.env.*
!.env.example

# ── Editor / OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Docker files (not needed inside the image) ─────────────────────────────
Dockerfile
.dockerignore
docker-compose*.yaml

# ── CI/CD / infra (not needed at runtime) ──────────────────────────────────
.github/
k8s/
terraform/
nginx/
Makefile
*.md

# ── Tool outputs ───────────────────────────────────────────────────────────
/tmp/
