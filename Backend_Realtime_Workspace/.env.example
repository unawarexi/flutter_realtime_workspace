# ============================================================================
# TeamSpot — Environment Variables
# Copy to .env and fill in your values
# ============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
BASE_URL=http://localhost:5000
API_VERSION=v1
FRONTEND_URL=http://localhost:3000

# ── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-in-production
JWT_EXPIRY=7d
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://teamspot:teamspot_dev_password@localhost:27017/teamspot_dev?authSource=admin
MONGO_DB_NAME=teamspot_dev
MONGO_POOL_SIZE=10

# ── Firebase ─────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT=./config/service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=teamspot-api
KAFKA_GROUP_ID=teamspot-consumer-group
KAFKA_SSL=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://teamspot:teamspot_dev_password@localhost:5672

# ── LiveKit ──────────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_HOST=http://localhost:7880

# ── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMTP / Mailer ────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@teamspot.io
SMTP_SECURE=false

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=debug
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true

# ── AI Service ───────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000/api/v1
AI_INTERNAL_API_KEY=
OPENAI_API_KEY=
