<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- App Store / TestFlight export -->
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store</string>

    <key>teamID</key>
    <string>YOUR_APPLE_TEAM_ID</string>

    <!-- Bitcode is deprecated in Xcode 14+ -->
    <key>uploadBitcode</key>
    <false/>

    <key>compileBitcode</key>
    <false/>

    <!-- Upload debug symbols to App Store Connect for crash symbolication -->
    <key>uploadSymbols</key>
    <true/>

    <key>signingStyle</key>
    <string>manual</string>

    <key>provisioningProfiles</key>
    <dict>
        <key>com.teamspot.app</key>
        <string>match AppStore com.teamspot.app</string>
    </dict>

    <key>stripSwiftSymbols</key>
    <true/>

    <key>thinning</key>
    <string>&lt;none&gt;</string>
</dict>
</plist>
