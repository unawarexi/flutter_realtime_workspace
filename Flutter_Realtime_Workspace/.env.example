# ──────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env locally, never commit .env
# All CI/CD secrets are stored as GitHub Actions / repository secrets
# ──────────────────────────────────────────────────────────────────────────────

# ── Android signing ──────────────────────────────────────────────────────────
ANDROID_KEYSTORE_BASE64=base64_encoded_keystore_here
ANDROID_KEY_ALIAS=teamspot
ANDROID_KEY_PASSWORD=your_key_password
ANDROID_STORE_PASSWORD=your_store_password

# ── Google Play ──────────────────────────────────────────────────────────────
# JSON content of the Google Play service account key file
GOOGLE_PLAY_JSON_KEY={"type":"service_account","project_id":"..."}

# ── Apple / App Store Connect ─────────────────────────────────────────────────
APP_STORE_CONNECT_API_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Base64-encoded content of the .p8 key downloaded from App Store Connect
APP_STORE_CONNECT_API_KEY_BASE64=base64_encoded_p8_key_here

# ── Fastlane Match ────────────────────────────────────────────────────────────
MATCH_GIT_URL=git@github.com:your-org/teamspot-certs.git
MATCH_PASSWORD=your_match_encryption_password

# ── Firebase ─────────────────────────────────────────────────────────────────
FIREBASE_TOKEN=your_firebase_ci_token            # firebase login:ci
FIREBASE_APP_ID_ANDROID=1:000000000000:android:xxxxxxxxxxxx
FIREBASE_APP_ID_IOS=1:000000000000:ios:xxxxxxxxxxxx

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=teamspot-flutter

# ── Notifications ─────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TXXXXXXXX/BXXXXXXXX/xxxxxxxx

# ── Codecov ───────────────────────────────────────────────────────────────────
CODECOV_TOKEN=your_codecov_token

# ── Build ─────────────────────────────────────────────────────────────────────
# Overridden by CI (e.g. GitHub run_number)
BUILD_NUMBER=1
